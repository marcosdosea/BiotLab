@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="mx-auto max-w-6xl">
    <div class="mb-8">
        <h1 class="text-3xl font-bold tracking-tight text-slate-900">Minha conta</h1>
        <p class="mt-2 text-sm text-slate-600">Gerencie suas informações de acesso e configurações pessoais.</p>
    </div>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-4">
        <aside class="lg:col-span-1">
            <div class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200">
                <partial name="_ManageNav" />
            </div>
        </aside>

        <section class="lg:col-span-3">
            <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
                <partial name="_StatusMessage" model='ViewData["StatusMessage"]' />
                @RenderBody()
            </div>
        </section>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}