@model BiotLabWeb.Models.EntradaanestesicoViewModel

@{
    ViewData["Title"] = "Criar Entrada de anestésico";
}

<div class="mb-8 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div class="flex items-start gap-4">
        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-blue-600 text-white shadow-lg shadow-blue-600/20">
            <i data-lucide="package-plus" class="h-7 w-7"></i>
        </div>
        <div>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">BiotLab</p>
            <h1 class="mt-1 text-3xl font-extrabold tracking-tight text-slate-950">Criar Entrada de anestésico</h1>
            <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Preencha os dados para cadastrar um novo registro.</p>
        </div>
    </div>
    
</div>

<div class="rounded-3xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 p-6">
        <h2 class="text-lg font-bold text-slate-950">Dados do cadastro</h2>
        <p class="mt-1 text-sm text-slate-500">Campos obrigatórios serão validados antes de salvar.</p>
    </div>

    <form asp-action="Create" method="post" class="p-6">
        
        <div asp-validation-summary="ModelOnly" class="mb-6 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700"></div>

        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            <div>
    <label asp-for="IdEntrada" class="mb-2 block text-sm font-semibold text-slate-700">Entrada</label>
    <select asp-for="IdEntrada" asp-items="ViewBag.Entradas" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100 disabled:cursor-not-allowed disabled:bg-slate-50">
        <option value="">Selecione uma entrada</option>
    </select>
    <span asp-validation-for="IdEntrada" class="mt-1 block text-xs font-medium text-red-600"></span>
</div>
<div>
    <label asp-for="IdAnestesico" class="mb-2 block text-sm font-semibold text-slate-700">Anestésico</label>
    <select asp-for="IdAnestesico" asp-items="ViewBag.Anestesicos" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100 disabled:cursor-not-allowed disabled:bg-slate-50">
        <option value="">Selecione um anestésico</option>
    </select>
    <span asp-validation-for="IdAnestesico" class="mt-1 block text-xs font-medium text-red-600"></span>
</div>
<div>
    <label asp-for="Quantidade" class="mb-2 block text-sm font-semibold text-slate-700">Quantidade</label>
    <input asp-for="Quantidade" type="number" step="0.01" min="0" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-100 disabled:cursor-not-allowed disabled:bg-slate-50" />
    <span asp-validation-for="Quantidade" class="mt-1 block text-xs font-medium text-red-600"></span>
</div>
<div>
    <label asp-for="Lote" class="mb-2 block text-sm font-semibold text-slate-700">Lote</label>
    <input asp-for="Lote" type="text" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-100 disabled:cursor-not-allowed disabled:bg-slate-50" />
    <span asp-validation-for="Lote" class="mt-1 block text-xs font-medium text-red-600"></span>
</div>
<div>
    <label asp-for="ValorUnitario" class="mb-2 block text-sm font-semibold text-slate-700">Valor unitário</label>
    <input asp-for="ValorUnitario" type="number" step="0.01" min="0" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-100 disabled:cursor-not-allowed disabled:bg-slate-50" />
    <span asp-validation-for="ValorUnitario" class="mt-1 block text-xs font-medium text-red-600"></span>
</div>
<div>
    <label asp-for="SubTotal" class="mb-2 block text-sm font-semibold text-slate-700">Subtotal</label>
    <input asp-for="SubTotal" type="number" step="0.01" min="0" readonly class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-100 disabled:cursor-not-allowed disabled:bg-slate-50 bg-slate-50" />
    <span asp-validation-for="SubTotal" class="mt-1 block text-xs font-medium text-red-600"></span>
</div>
        </div>

        <div class="mt-8 flex flex-col-reverse gap-3 border-t border-slate-200 pt-6 sm:flex-row sm:justify-end">
            <a asp-action="Index" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white px-5 py-3 text-sm font-bold text-slate-700 transition hover:bg-slate-50">
                <i data-lucide="arrow-left" class="h-4 w-4"></i>
                Voltar
            </a>
            <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-2xl bg-blue-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-blue-600/20 transition hover:-translate-y-0.5 hover:bg-blue-700">
                <i data-lucide="save" class="h-4 w-4"></i>
                Salvar
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function calcularSubtotalEntradaAnestesico() {
            const quantidade = Number.parseFloat(document.getElementById("Quantidade")?.value?.replace(",", ".") || "0");
            const valor = Number.parseFloat(document.getElementById("ValorUnitario")?.value?.replace(",", ".") || "0");
            const subtotal = quantidade * valor;
            const campoSubtotal = document.getElementById("SubTotal");
            if (campoSubtotal) {
                campoSubtotal.value = Number.isFinite(subtotal) ? subtotal.toFixed(2) : "0.00";
            }
        }

        document.getElementById("Quantidade")?.addEventListener("input", calcularSubtotalEntradaAnestesico);
        document.getElementById("ValorUnitario")?.addEventListener("input", calcularSubtotalEntradaAnestesico);
        calcularSubtotalEntradaAnestesico();
    </script>
}
