@model IEnumerable<BiotLabWeb.Models.GaiolaharemViewModel>
@using System.Linq

@{
    ViewData["Title"] = "Gaiola-Berçário";
}

<div class="mb-8 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div class="flex items-start gap-4">
        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-blue-600 text-white shadow-lg shadow-blue-600/20">
            <i data-lucide="git-branch" class="h-7 w-7"></i>
        </div>
        <div>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">BiotLab</p>
            <h1 class="mt-1 text-3xl font-extrabold tracking-tight text-slate-950">Gaiola-Berçário</h1>
            <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Controle vínculos entre gaiolas, berçários e pesquisadores.</p>
        </div>
    </div>
    <a asp-action="Create" class="inline-flex items-center justify-center gap-2 rounded-2xl bg-blue-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-blue-600/20 transition hover:-translate-y-0.5 hover:bg-blue-700">
        <i data-lucide="plus" class="h-4 w-4"></i>
        Novo cadastro
    </a>
</div>

<div class="mb-6 grid grid-cols-1 gap-4 md:grid-cols-3">
<div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
    <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Total</p>
    <p class="mt-3 text-3xl font-extrabold tracking-tight text-slate-950">@(Model?.Count() ?? 0)</p>
</div>
<div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
    <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Com gaiola</p>
    <p class="mt-3 text-3xl font-extrabold tracking-tight text-slate-950">@(Model?.Count(x => !string.IsNullOrWhiteSpace(x.CodigoInternoGaiola)) ?? 0)</p>
</div>
<div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
    <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Com berçário</p>
    <p class="mt-3 text-3xl font-extrabold tracking-tight text-slate-950">@(Model?.Count(x => !string.IsNullOrWhiteSpace(x.CodigoInternoHarem)) ?? 0)</p>
</div>
</div>

<div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
    <div class="flex flex-col gap-4 border-b border-slate-200 p-5 lg:flex-row lg:items-center lg:justify-between">
        <div>
            <h2 class="text-lg font-bold text-slate-950">Registros cadastrados</h2>
            <p class="mt-1 text-sm text-slate-500">Pesquise, visualize, edite ou remova informações.</p>
        </div>
        <div class="relative w-full lg:max-w-sm">
            <i data-lucide="search" class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"></i>
            <input type="search" data-table-search placeholder="Buscar nesta tabela..." class="w-full rounded-2xl border border-slate-200 bg-slate-50 py-3 pl-11 pr-4 text-sm outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100" />
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200" data-table>
                <thead class="bg-slate-50/80">
                    <tr>
                        <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-[0.16em] text-slate-500">Gaiola</th>
<th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-[0.16em] text-slate-500">Berçário</th>
<th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-[0.16em] text-slate-500">Data de povoamento</th>
<th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-[0.16em] text-slate-500">Pesquisador</th>
                        <th class="px-6 py-4 text-right text-xs font-bold uppercase tracking-[0.16em] text-slate-500">Ações</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 bg-white">
                    @foreach (var item in Model)
                    {
                        <tr class="transition hover:bg-blue-50/40">
                            <td class="px-6 py-4 text-sm text-slate-700">@item.CodigoInternoGaiola</td>
<td class="px-6 py-4 text-sm text-slate-700">@item.CodigoInternoHarem</td>
<td class="px-6 py-4 text-sm text-slate-700">@item.DataPovoamento.ToString("dd/MM/yyyy")</td>
<td class="px-6 py-4 text-sm text-slate-700">@(item.NomePesquisador ?? "—")</td>
                            <td class="px-6 py-4 text-right text-sm font-semibold">
                                <div class="flex flex-wrap justify-end gap-2">
                                    <a asp-action="Details" asp-route-idGaiola="@item.IdGaiola" asp-route-idHarem="@item.IdHarem" class="inline-flex items-center gap-1 rounded-xl border border-slate-200 bg-white px-3 py-2 text-slate-700 transition hover:border-blue-200 hover:text-blue-700">
                                        <i data-lucide="eye" class="h-4 w-4"></i> Detalhes
                                    </a>
                                    <a asp-action="Edit" asp-route-idGaiola="@item.IdGaiola" asp-route-idHarem="@item.IdHarem" class="inline-flex items-center gap-1 rounded-xl border border-blue-200 bg-blue-50 px-3 py-2 text-blue-700 transition hover:bg-blue-100">
                                        <i data-lucide="pencil" class="h-4 w-4"></i> Editar
                                    </a>
                                    <a asp-action="Delete" asp-route-idGaiola="@item.IdGaiola" asp-route-idHarem="@item.IdHarem" class="inline-flex items-center gap-1 rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-red-700 transition hover:bg-red-100">
                                        <i data-lucide="trash-2" class="h-4 w-4"></i> Excluir
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="px-6 py-16 text-center">
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-blue-50 text-blue-600">
                <i data-lucide="inbox" class="h-8 w-8"></i>
            </div>
            <h3 class="mt-4 text-lg font-bold text-slate-950">Nenhum registro encontrado</h3>
            <p class="mt-2 text-sm text-slate-500">Cadastre o primeiro item para começar a usar este módulo.</p>
            <a asp-action="Create" class="mt-6 inline-flex items-center justify-center gap-2 rounded-2xl bg-blue-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-blue-600/20 transition hover:bg-blue-700">
                <i data-lucide="plus" class="h-4 w-4"></i>
                Cadastrar agora
            </a>
        </div>
    }
</div>
