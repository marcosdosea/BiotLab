@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirmação de cadastro";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<div class="flex min-h-screen items-center justify-center px-4 py-10">
    <div class="w-full max-w-lg rounded-[2rem] border border-slate-200 bg-white p-8 text-center shadow-2xl shadow-slate-900/10">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-blue-50 text-blue-700">
            <i data-lucide="mail-check" class="h-8 w-8"></i>
        </div>
        <h1 class="mt-6 text-2xl font-black text-slate-950">Confirme seu cadastro</h1>
        @if (Model.DisplayConfirmAccountLink)
        {
            <p class="mt-4 text-sm leading-6 text-slate-600">O envio real de e-mail ainda não está configurado. Use o link abaixo para confirmar a conta durante o desenvolvimento.</p>
            <a id="confirm-link" href="@Model.EmailConfirmationUrl" class="mt-6 inline-flex items-center justify-center gap-2 rounded-2xl bg-blue-600 px-5 py-3 text-sm font-black text-white shadow-lg shadow-blue-600/20 transition hover:bg-blue-700">
                Confirmar conta
            </a>
        }
        else
        {
            <p class="mt-4 text-sm leading-6 text-slate-600">Enviamos um link de confirmação para o seu e-mail. Confirme a conta antes de acessar o sistema.</p>
            <a asp-page="./Login" class="mt-6 inline-flex items-center justify-center gap-2 rounded-2xl bg-blue-600 px-5 py-3 text-sm font-black text-white shadow-lg shadow-blue-600/20 transition hover:bg-blue-700">
                Ir para o login
            </a>
        }
    </div>
</div>
