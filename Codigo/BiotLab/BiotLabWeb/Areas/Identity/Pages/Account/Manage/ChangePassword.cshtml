@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Alterar senha";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="max-w-2xl">
    <div class="mb-6">
        <h2 class="text-2xl font-bold text-slate-900">Alterar senha</h2>
        <p class="mt-2 text-sm text-slate-600">
            Atualize sua senha para manter sua conta segura.
        </p>
    </div>

    <form id="change-password-form" method="post" class="space-y-5">
        <div asp-validation-summary="ModelOnly"
             class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        </div>

        <div>
            <label asp-for="Input.OldPassword" class="mb-2 block text-sm font-medium text-slate-700">
                Senha atual
            </label>
            <input asp-for="Input.OldPassword"
                   autocomplete="current-password"
                   class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200" />
            <span asp-validation-for="Input.OldPassword" class="mt-1 block text-sm text-red-600"></span>
        </div>

        <div>
            <label asp-for="Input.NewPassword" class="mb-2 block text-sm font-medium text-slate-700">
                Nova senha
            </label>
            <input asp-for="Input.NewPassword"
                   autocomplete="new-password"
                   class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200" />
            <span asp-validation-for="Input.NewPassword" class="mt-1 block text-sm text-red-600"></span>
        </div>

        <div>
            <label asp-for="Input.ConfirmPassword" class="mb-2 block text-sm font-medium text-slate-700">
                Confirmar nova senha
            </label>
            <input asp-for="Input.ConfirmPassword"
                   autocomplete="new-password"
                   class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200" />
            <span asp-validation-for="Input.ConfirmPassword" class="mt-1 block text-sm text-red-600"></span>
        </div>

        <button type="submit"
                class="inline-flex items-center justify-center rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-blue-700">
            Atualizar senha
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}