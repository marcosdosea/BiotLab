@model BiotLabWeb.Models.ObituarioViewModel

@{
    ViewData["Title"] = "Detalhes - Registro de óbito";
}

<div class="mb-8 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div class="flex items-start gap-4">
        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-blue-600 text-white shadow-lg shadow-blue-600/20">
            <i data-lucide="clipboard-x" class="h-7 w-7"></i>
        </div>
        <div>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">BiotLab</p>
            <h1 class="mt-1 text-3xl font-extrabold tracking-tight text-slate-950">Detalhes de Registro de óbito</h1>
            <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Confira os dados completos deste registro antes de realizar alterações.</p>
        </div>
    </div>
    
</div>

<div class="rounded-3xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 p-6">
        <h2 class="text-lg font-bold text-slate-950">Informações do registro</h2>
        <p class="mt-1 text-sm text-slate-500">Dados apresentados conforme o cadastro atual.</p>
    </div>
    <dl class="grid grid-cols-1 gap-4 p-6 md:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4">
    <dt class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Código</dt>
    <dd class="mt-2 break-words text-sm font-semibold text-slate-800">@Model.Id</dd>
</div>
<div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4">
    <dt class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Data</dt>
    <dd class="mt-2 break-words text-sm font-semibold text-slate-800">@Model.Data.ToString("dd/MM/yyyy")</dd>
</div>
<div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4">
    <dt class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Gaiola</dt>
    <dd class="mt-2 break-words text-sm font-semibold text-slate-800">@Model.IdGaiola</dd>
</div>
<div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4">
    <dt class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Pesquisador</dt>
    <dd class="mt-2 break-words text-sm font-semibold text-slate-800">@(Model.NomePesquisador ?? "Pesquisador não encontrado")</dd>
</div>
<div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4 md:col-span-2">
    <dt class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Observações</dt>
    <dd class="mt-2 whitespace-pre-wrap break-words text-sm font-semibold text-slate-800">@(string.IsNullOrWhiteSpace(Model.Observacoes) ? "Nenhuma observação informada." : Model.Observacoes)</dd>
</div>
    </dl>
    <div class="flex flex-col-reverse gap-3 border-t border-slate-200 p-6 sm:flex-row sm:justify-end">
        <a asp-action="Index" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white px-5 py-3 text-sm font-bold text-slate-700 transition hover:bg-slate-50">
            <i data-lucide="arrow-left" class="h-4 w-4"></i> Voltar
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="inline-flex items-center justify-center gap-2 rounded-2xl bg-blue-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-blue-600/20 transition hover:bg-blue-700">
            <i data-lucide="pencil" class="h-4 w-4"></i> Editar
        </a>
    </div>
</div>
