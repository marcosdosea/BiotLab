@model IEnumerable<BiotLabWeb.Models.AdminUsuarios.UsuarioListagemViewModel>
@using System.Linq

@{
    ViewData["Title"] = "Gerenciar usuários";
}

<div class="mb-8 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div class="flex items-start gap-4">
        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-blue-600 text-white shadow-lg shadow-blue-600/20">
            <i data-lucide="users" class="h-7 w-7"></i>
        </div>
        <div>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">BiotLab</p>
            <h1 class="mt-1 text-3xl font-extrabold tracking-tight text-slate-950">Gerenciar usuários</h1>
            <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Visualize perfis, status de confirmação e remova contas quando necessário.</p>
        </div>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row">
        <a asp-action="NovoEstudante" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-blue-200 bg-white px-5 py-3 text-sm font-bold text-blue-700 shadow-sm transition hover:bg-blue-50">
            <i data-lucide="user-plus" class="h-4 w-4"></i> Convidar estudante/pesquisador
        </a>
        <a asp-action="NovoAdministrador" class="inline-flex items-center justify-center gap-2 rounded-2xl bg-blue-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-blue-600/20 transition hover:bg-blue-700">
            <i data-lucide="shield-plus" class="h-4 w-4"></i> Convidar administrador
        </a>
    </div>
</div>

@if (TempData["Sucesso"] != null)
{
    <div class="mb-4 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-bold text-emerald-700">@TempData["Sucesso"]</div>
}
@if (TempData["Erro"] != null)
{
    <div class="mb-4 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-bold text-red-700">@TempData["Erro"]</div>
}

<div class="mb-6 grid grid-cols-1 gap-4 md:grid-cols-3">
    <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm"><p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Total</p><p class="mt-3 text-3xl font-extrabold tracking-tight text-slate-950">@(Model?.Count() ?? 0)</p></div>
    <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm"><p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Administradores</p><p class="mt-3 text-3xl font-extrabold tracking-tight text-slate-950">@(Model?.Count(x => x.Perfil == "Administrador") ?? 0)</p></div>
    <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm"><p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Pendentes</p><p class="mt-3 text-3xl font-extrabold tracking-tight text-slate-950">@(Model?.Count(x => x.Status == "Pendente") ?? 0)</p></div>
</div>

<div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
    <div class="flex flex-col gap-4 border-b border-slate-200 p-5 lg:flex-row lg:items-center lg:justify-between">
        <div>
            <h2 class="text-lg font-bold text-slate-950">Usuários cadastrados</h2>
            <p class="mt-1 text-sm text-slate-500">Acompanhe perfis e pendências de confirmação.</p>
        </div>
        <div class="relative w-full lg:max-w-sm">
            <i data-lucide="search" class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"></i>
            <input type="search" data-table-search placeholder="Buscar usuário..." class="w-full rounded-2xl border border-slate-200 bg-slate-50 py-3 pl-11 pr-4 text-sm outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100" />
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200" data-table>
                <thead class="bg-slate-50/80">
                    <tr>
                        <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-[0.16em] text-slate-500">Nome</th>
                        <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-[0.16em] text-slate-500">E-mail</th>
                        <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-[0.16em] text-slate-500">Perfil</th>
                        <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-[0.16em] text-slate-500">Status</th>
                        <th class="px-6 py-4 text-right text-xs font-bold uppercase tracking-[0.16em] text-slate-500">Ações</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 bg-white">
                    @foreach (var item in Model)
                    {
                        <tr class="transition hover:bg-blue-50/40">
                            <td class="px-6 py-4 text-sm font-bold text-slate-950">@item.NomeCompleto</td>
                            <td class="px-6 py-4 text-sm text-slate-700">@item.Email</td>
                            <td class="px-6 py-4 text-sm">
                                @if (item.Perfil == "Administrador")
                                {
                                    <span class="inline-flex rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700">Administrador</span>
                                }
                                else
                                {
                                    <span class="inline-flex rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">@item.Perfil</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-sm">
                                @if (item.Status == "Aceito")
                                {
                                    <span class="inline-flex rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">Aceito</span>
                                }
                                else
                                {
                                    <span class="inline-flex rounded-full bg-amber-50 px-3 py-1 text-xs font-bold text-amber-700">Pendente</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-right text-sm font-semibold">
                                @if (item.EhUsuarioAtual)
                                {
                                    <span class="inline-flex items-center gap-1 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-slate-500">
                                        <i data-lucide="user-check" class="h-4 w-4"></i> Usuário atual
                                    </span>
                                }
                                else
                                {
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="inline-flex items-center gap-1 rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-red-700 transition hover:bg-red-100">
                                        <i data-lucide="trash-2" class="h-4 w-4"></i> @(item.EhConvite ? "Excluir convite" : "Excluir")
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="px-6 py-16 text-center text-sm font-semibold text-slate-500">Nenhum usuário cadastrado.</div>
    }
</div>
