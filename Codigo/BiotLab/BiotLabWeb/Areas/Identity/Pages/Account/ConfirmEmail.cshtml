@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Confirmar e-mail";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<div class="flex min-h-screen items-center justify-center px-4 py-10">
    <div class="w-full max-w-md rounded-[2rem] border border-slate-200 bg-white p-8 text-center shadow-2xl shadow-slate-900/10">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-700">
            <i data-lucide="badge-check" class="h-8 w-8"></i>
        </div>
        <h1 class="mt-6 text-2xl font-black text-slate-950">Confirmação de e-mail</h1>
        <div class="mt-4 text-sm font-semibold text-slate-600">
            <partial name="_StatusMessage" model="Model.StatusMessage" />
        </div>
        <a asp-page="./Login" class="mt-6 inline-flex items-center justify-center gap-2 rounded-2xl bg-blue-600 px-5 py-3 text-sm font-black text-white shadow-lg shadow-blue-600/20 transition hover:bg-blue-700">
            Ir para o login
        </a>
    </div>
</div>
