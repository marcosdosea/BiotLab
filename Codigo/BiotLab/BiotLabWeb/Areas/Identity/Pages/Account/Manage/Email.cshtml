@page
@model EmailModel
@{
    ViewData["Title"] = "E-mail";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<div class="max-w-2xl space-y-8">
    <div>
        <h2 class="text-2xl font-bold text-slate-900">E-mail</h2>
        <p class="mt-2 text-sm text-slate-600">
            Gerencie seu e-mail de acesso e confirme sua conta.
        </p>
    </div>

    <form id="email-form" method="post" class="space-y-5">
        <div asp-validation-summary="All"
             class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        </div>

        @if (Model.IsEmailConfirmed)
        {
            <div>
                <label asp-for="Email" class="mb-2 block text-sm font-medium text-slate-700">E-mail atual</label>
                <div class="flex gap-3">
                    <input asp-for="Email"
                           class="w-full rounded-xl border border-slate-300 bg-slate-100 px-4 py-3 text-sm text-slate-600"
                           disabled />
                    <span class="inline-flex items-center rounded-xl bg-green-100 px-4 py-3 text-sm font-semibold text-green-700">
                        Confirmado
                    </span>
                </div>
            </div>
        }
        else
        {
            <div>
                <label asp-for="Email" class="mb-2 block text-sm font-medium text-slate-700">E-mail atual</label>
                <input asp-for="Email"
                       class="w-full rounded-xl border border-slate-300 bg-slate-100 px-4 py-3 text-sm text-slate-600"
                       disabled />
            </div>

            <button id="email-verification"
                    type="submit"
                    asp-page-handler="SendVerificationEmail"
                    class="inline-flex items-center justify-center rounded-xl border border-blue-200 bg-blue-50 px-5 py-3 text-sm font-semibold text-blue-700 transition hover:bg-blue-100">
                Reenviar confirmação
            </button>
        }

        <div>
            <label asp-for="Input.NewEmail" class="mb-2 block text-sm font-medium text-slate-700">
                Novo e-mail
            </label>
            <input asp-for="Input.NewEmail"
                   class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200" />
            <span asp-validation-for="Input.NewEmail" class="mt-1 block text-sm text-red-600"></span>
        </div>

        <button id="change-email-button"
                type="submit"
                asp-page-handler="ChangeEmail"
                class="inline-flex items-center justify-center rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-blue-700">
            Alterar e-mail
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}