@model BiotLabWeb.Models.UsoanestesicoViewModel

@{
    ViewData["Title"] = "Excluir - Uso de anestésico";
}

<div class="mb-8 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div class="flex items-start gap-4">
        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-blue-600 text-white shadow-lg shadow-blue-600/20">
            <i data-lucide="triangle-alert" class="h-7 w-7"></i>
        </div>
        <div>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">BiotLab</p>
            <h1 class="mt-1 text-3xl font-extrabold tracking-tight text-slate-950">Excluir Uso de anestésico</h1>
            <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Revise as informações abaixo. Esta ação remove o registro selecionado.</p>
        </div>
    </div>
    
</div>

<div class="rounded-3xl border border-red-200 bg-white shadow-sm">
    <div class="border-b border-red-100 bg-red-50/80 p-6">
        <div class="flex gap-4">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-red-100 text-red-700">
                <i data-lucide="trash-2" class="h-6 w-6"></i>
            </div>
            <div>
                <h2 class="text-lg font-extrabold text-red-900">Confirmar exclusão</h2>
                <p class="mt-1 text-sm leading-6 text-red-700">A operação não poderá ser desfeita depois de confirmada.</p>
            </div>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="mx-6 mt-6 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700"></div>
    }
    <dl class="grid grid-cols-1 gap-4 p-6 md:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4">
    <dt class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Código</dt>
    <dd class="mt-2 break-words text-sm font-semibold text-slate-800">@Model.Id</dd>
</div>
<div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4">
    <dt class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Data</dt>
    <dd class="mt-2 break-words text-sm font-semibold text-slate-800">@Model.Data.ToString("dd/MM/yyyy")</dd>
</div>
<div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4">
    <dt class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Pesquisador</dt>
    <dd class="mt-2 break-words text-sm font-semibold text-slate-800">@(Model.NomePesquisador ?? "—")</dd>
</div>
<div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4">
    <dt class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Experimento</dt>
    <dd class="mt-2 break-words text-sm font-semibold text-slate-800">@(Model.NomeExperimento ?? "—")</dd>
</div>
<div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4">
    <dt class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Anestésico</dt>
    <dd class="mt-2 break-words text-sm font-semibold text-slate-800">@(Model.NomeAnestesico ?? "—")</dd>
</div>
<div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4">
    <dt class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Lote</dt>
    <dd class="mt-2 break-words text-sm font-semibold text-slate-800">@(Model.Lote ?? "—")</dd>
</div>
<div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4">
    <dt class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Quantidade</dt>
    <dd class="mt-2 break-words text-sm font-semibold text-slate-800">@Model.Quantidade.ToString("N2")</dd>
</div>
<div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4">
    <dt class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Procedimento</dt>
    <dd class="mt-2 break-words text-sm font-semibold text-slate-800">@Model.Procedimento</dd>
</div>
    </dl>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="flex flex-col-reverse gap-3 border-t border-slate-200 p-6 sm:flex-row sm:justify-end">
        <input type="hidden" asp-for="Id" />
        <a asp-action="Index" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white px-5 py-3 text-sm font-bold text-slate-700 transition hover:bg-slate-50">
            <i data-lucide="arrow-left" class="h-4 w-4"></i> Cancelar
        </a>
        <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-2xl bg-red-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-red-600/20 transition hover:bg-red-700">
            <i data-lucide="trash-2" class="h-4 w-4"></i> Excluir definitivamente
        </button>
    </form>
</div>
