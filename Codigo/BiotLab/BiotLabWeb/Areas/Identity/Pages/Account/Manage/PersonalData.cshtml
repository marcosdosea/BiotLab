@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Dados pessoais";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="max-w-2xl space-y-8">
    <div>
        <h2 class="text-2xl font-bold text-slate-900">Dados pessoais</h2>
        <p class="mt-2 text-sm text-slate-600">
            Aqui você pode baixar ou excluir permanentemente os dados vinculados à sua conta.
        </p>
    </div>

    <div class="rounded-2xl border border-amber-200 bg-amber-50 p-5 text-sm text-amber-800">
        <p class="font-semibold">Atenção</p>
        <p class="mt-2">
            Excluir seus dados removerá permanentemente sua conta, e essa ação não poderá ser desfeita.
        </p>
    </div>

    <div class="flex flex-wrap gap-3">
        <a id="download-data"
           asp-page="./DownloadPersonalData"
           class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-100">
            Baixar meus dados
        </a>

        <a id="delete"
           asp-page="./DeletePersonalData"
           class="inline-flex items-center justify-center rounded-xl bg-red-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-red-700">
            Excluir conta
        </a>
    </div>
</div>