@page
@model ResetPasswordConfirmationModel

@{
    ViewData["Title"] = "Senha redefinida";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<div class="grid min-h-screen lg:grid-cols-[1fr_0.9fr]">
    <section class="hidden bg-slate-950 p-10 text-white lg:flex lg:flex-col lg:justify-between">
        <a asp-area="Identity" asp-page="/Account/Login" class="inline-flex items-center gap-3">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-600 shadow-lg shadow-blue-600/30">
                <i data-lucide="flask-conical" class="h-7 w-7"></i>
            </span>
            <span>
                <span class="block text-2xl font-black tracking-tight">BiotLab</span>
                <span class="block text-xs font-bold uppercase tracking-[0.2em] text-blue-200">Gestão de biotérios</span>
            </span>
        </a>
        <div>
            <span class="inline-flex rounded-full bg-white/10 px-4 py-2 text-xs font-bold uppercase tracking-[0.18em] text-blue-100 ring-1 ring-white/10">Acesso seguro</span>
            <h1 class="mt-6 max-w-xl text-5xl font-black tracking-tight">Organização, rastreabilidade e controle para seu biotério.</h1>
            <p class="mt-5 max-w-lg text-base leading-7 text-slate-300">Entre na plataforma para acessar os módulos disponíveis ao seu perfil.</p>
        </div>
        <p class="text-sm text-slate-400">&copy; @DateTime.Now.Year BiotLab</p>
    </section>
    <section class="flex items-center justify-center px-4 py-10 sm:px-6 lg:px-10">
        <div class="w-full max-w-md">
            <div class="mb-8 text-center lg:hidden">
                <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-600 text-white shadow-lg shadow-blue-600/25">
                    <i data-lucide="flask-conical" class="h-8 w-8"></i>
                </div>
                <h1 class="mt-4 text-3xl font-black tracking-tight text-slate-950">BiotLab</h1>
            </div>
            <div class="rounded-[2rem] border border-slate-200 bg-white p-7 shadow-2xl shadow-slate-900/10 sm:p-8">
                <div class="mb-7">
                    <p class="text-sm font-bold uppercase tracking-[0.18em] text-blue-600">Senha atualizada</p>
                    <h2 class="mt-2 text-2xl font-black tracking-tight text-slate-950">Sua senha foi redefinida</h2>
                    <p class="mt-2 text-sm leading-6 text-slate-500">Agora você pode acessar o sistema usando a nova senha.</p>
                </div>
<div class="rounded-3xl border border-slate-200 bg-slate-50 p-6 text-center">
    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-blue-50 text-blue-700">
        <i data-lucide="check-circle-2" class="h-8 w-8"></i>
    </div>
    <div class="mt-5 text-sm leading-6 text-slate-600">
        A alteração foi concluída com sucesso.
    </div>
    <a asp-page="./Login" class="mt-6 inline-flex items-center justify-center gap-2 rounded-2xl bg-blue-600 px-5 py-3 text-sm font-black text-white shadow-lg shadow-blue-600/20 transition hover:bg-blue-700">
        <i data-lucide="log-in" class="h-4 w-4"></i> Ir para o login
    </a>
</div>
            </div>
        </div>
    </section>
</div>
