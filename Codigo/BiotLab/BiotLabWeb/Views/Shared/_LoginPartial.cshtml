@using Microsoft.AspNetCore.Identity
@using BiotLabWeb.Areas.Identity.Data
@inject SignInManager<UsuarioIdentity> SignInManager
@inject UserManager<UsuarioIdentity> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <div class="flex items-center gap-3 text-sm text-slate-600">
        <span class="font-semibold">@UserManager.GetUserName(User)</span>
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl='@Url.Action("Index", "Home", new { area = "" })' method="post">
            <button type="submit" class="font-bold text-red-600 hover:text-red-700">Sair</button>
        </form>
    </div>
}
else
{
    <div class="flex items-center gap-3 text-sm font-bold">
        <a asp-area="Identity" asp-page="/Account/Login" class="rounded-xl bg-blue-600 px-4 py-2 text-white hover:bg-blue-700">Entrar</a>
    </div>
}
