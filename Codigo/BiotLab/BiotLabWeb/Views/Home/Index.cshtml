@{
    ViewData["Title"] = "Início";
}

<div class="space-y-8">
    <section class="relative overflow-hidden rounded-[2rem] bg-slate-950 p-8 text-white shadow-2xl shadow-slate-950/20 lg:p-10">
        <div class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-blue-500/30 blur-3xl"></div>
        <div class="absolute -bottom-28 left-1/2 h-72 w-72 rounded-full bg-emerald-500/20 blur-3xl"></div>
        <div class="relative max-w-3xl">
            <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-xs font-bold uppercase tracking-[0.18em] text-blue-100 ring-1 ring-white/15">
                <i data-lucide="sparkles" class="h-4 w-4"></i>
                Dashboard BiotLab
            </span>
            <h1 class="mt-6 text-4xl font-black tracking-tight sm:text-5xl">Gestão centralizada para biotérios acadêmicos.</h1>
            <p class="mt-4 max-w-2xl text-base leading-7 text-slate-300">Acesse rapidamente os módulos permitidos para o seu perfil e mantenha os registros organizados, rastreáveis e padronizados.</p>
        </div>
    </section>

    <section>
        <div class="mb-5 flex items-end justify-between gap-4">
            <div>
                <p class="text-sm font-bold uppercase tracking-[0.18em] text-blue-600">Módulos</p>
                <h2 class="mt-1 text-2xl font-black text-slate-950">Acessos disponíveis</h2>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
            @if (User.IsInRole("Administrador") || User.IsInRole("PesquisadorSenior"))
            {
                <a asp-controller="Instituicao" asp-action="Index" class="module-card"><i data-lucide="building-2"></i><span><strong>Instituições</strong><small>@(User.IsInRole("Administrador") ? "Cadastro e dados institucionais." : "Consulta de dados institucionais.")</small></span></a>
            }

            @if (User.IsInRole("PesquisadorSenior"))
            {
                <a asp-controller="Bioterio" asp-action="Index" class="module-card"><i data-lucide="warehouse"></i><span><strong>Biotérios</strong><small>Unidades, contatos e localização.</small></span></a>
                <a asp-controller="Pesquisador" asp-action="Index" class="module-card"><i data-lucide="user-round-search"></i><span><strong>Pesquisadores</strong><small>Responsáveis e dados de contato.</small></span></a>
                <a asp-controller="Fornecedor" asp-action="Index" class="module-card"><i data-lucide="truck"></i><span><strong>Fornecedores</strong><small>Fornecedores e vínculos.</small></span></a>
                <a asp-controller="Entradum" asp-action="Index" class="module-card"><i data-lucide="file-input"></i><span><strong>Entradas</strong><small>Notas fiscais e estoque.</small></span></a>
                <a asp-controller="Anestesico" asp-action="Index" class="module-card"><i data-lucide="flask-conical"></i><span><strong>Anestésicos</strong><small>Marcas, concentração e instituição.</small></span></a>
                <a asp-controller="Entradaanestesico" asp-action="Index" class="module-card"><i data-lucide="package-plus"></i><span><strong>Entrada anestésico</strong><small>Lotes, quantidades e valores.</small></span></a>
            }

            @if (User.IsInRole("Administrador") || User.IsInRole("PesquisadorSenior"))
            {
                <a asp-controller="AdminUsuarios" asp-action="Index" class="module-card"><i data-lucide="users"></i><span><strong>Convidar Pesquisador</strong><small>Envie convites para novos pesquisadores.</small></span></a>
            }

            @if (User.IsInRole("PesquisadorSenior") || User.IsInRole("Estudante"))
            {
                <a asp-controller="Experimento" asp-action="Index" class="module-card"><i data-lucide="microscope"></i><span><strong>Experimentos</strong><small>Estudos e períodos.</small></span></a>
                <a asp-controller="Gaiola" asp-action="Index" class="module-card"><i data-lucide="box"></i><span><strong>Gaiolas</strong><small>Localização, status e população.</small></span></a>
                <a asp-controller="Harem" asp-action="Index" class="module-card"><i data-lucide="heart-pulse"></i><span><strong>Haréns</strong><small>Reprodução e acompanhamento.</small></span></a>
                <a asp-controller="Gaiolaharem" asp-action="Index" class="module-card"><i data-lucide="git-branch"></i><span><strong>Gaiola-Berçário</strong><small>Vínculos e povoamento.</small></span></a>
                <a asp-controller="Usoanestesico" asp-action="Index" class="module-card"><i data-lucide="syringe"></i><span><strong>Uso anestésico</strong><small>Anestésicos, procedimentos e consumo.</small></span></a>
                <a asp-controller="Obituario" asp-action="Index" class="module-card"><i data-lucide="clipboard-x"></i><span><strong>Obituário</strong><small>Registros de óbito.</small></span></a>
            }
        </div>
    </section>
</div>
