@page
@model ExternalLoginModel

@{
    ViewData["Title"] = "Cadastro externo";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<div class="grid min-h-screen lg:grid-cols-[1fr_0.9fr]">
    <section class="hidden bg-slate-950 p-10 text-white lg:flex lg:flex-col lg:justify-between">
        <a asp-area="Identity" asp-page="/Account/Login" class="inline-flex items-center gap-3">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-600 shadow-lg shadow-blue-600/30">
                <i data-lucide="flask-conical" class="h-7 w-7"></i>
            </span>
            <span>
                <span class="block text-2xl font-black tracking-tight">BiotLab</span>
                <span class="block text-xs font-bold uppercase tracking-[0.2em] text-blue-200">Gestão de biotérios</span>
            </span>
        </a>
        <div>
            <span class="inline-flex rounded-full bg-white/10 px-4 py-2 text-xs font-bold uppercase tracking-[0.18em] text-blue-100 ring-1 ring-white/10">Acesso seguro</span>
            <h1 class="mt-6 max-w-xl text-5xl font-black tracking-tight">Organização, rastreabilidade e controle para seu biotério.</h1>
            <p class="mt-5 max-w-lg text-base leading-7 text-slate-300">Entre na plataforma para acessar os módulos disponíveis ao seu perfil.</p>
        </div>
        <p class="text-sm text-slate-400">&copy; @DateTime.Now.Year BiotLab</p>
    </section>
    <section class="flex items-center justify-center px-4 py-10 sm:px-6 lg:px-10">
        <div class="w-full max-w-md">
            <div class="mb-8 text-center lg:hidden">
                <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-600 text-white shadow-lg shadow-blue-600/25">
                    <i data-lucide="flask-conical" class="h-8 w-8"></i>
                </div>
                <h1 class="mt-4 text-3xl font-black tracking-tight text-slate-950">BiotLab</h1>
            </div>
            <div class="rounded-[2rem] border border-slate-200 bg-white p-7 shadow-2xl shadow-slate-900/10 sm:p-8">
                <div class="mb-7">
                    <p class="text-sm font-bold uppercase tracking-[0.18em] text-blue-600">Conta externa</p>
                    <h2 class="mt-2 text-2xl font-black tracking-tight text-slate-950">Associar conta externa</h2>
                    <p class="mt-2 text-sm leading-6 text-slate-500">Complete o cadastro informando um e-mail para esta conta.</p>
                </div>
<p class="mb-5 rounded-2xl border border-blue-100 bg-blue-50 px-4 py-3 text-sm font-semibold text-blue-700">
    Autenticado com <strong>@Model.ProviderDisplayName</strong>. Informe o e-mail para concluir o vínculo.
</p>
<form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="space-y-5">
    <div asp-validation-summary="ModelOnly" class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700" role="alert"></div>
    <div>
        <label asp-for="Input.Email" class="mb-2 block text-sm font-bold text-slate-700"></label>
        <input asp-for="Input.Email" autocomplete="email" placeholder="seuemail@exemplo.com" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-100" />
        <span asp-validation-for="Input.Email" class="mt-1 block text-xs font-semibold text-red-600"></span>
    </div>
    <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-blue-600 px-5 py-3 text-sm font-black text-white shadow-lg shadow-blue-600/20 transition hover:bg-blue-700">Finalizar cadastro</button>
</form>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
