@page
@model IndexModel
@{
    ViewData["Title"] = "Perfil";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="max-w-2xl">
    <div class="mb-6">
        <h2 class="text-2xl font-bold text-slate-900">Perfil</h2>
        <p class="mt-2 text-sm text-slate-600">
            Atualize suas informações básicas de conta.
        </p>
    </div>

    <form id="profile-form" method="post" class="space-y-5">
        <div asp-validation-summary="ModelOnly"
             class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        </div>

        <div>
            <label class="mb-2 block text-sm font-medium text-slate-700">Nome de usuário</label>
            <input asp-for="Username"
                   class="w-full rounded-xl border border-slate-300 bg-slate-100 px-4 py-3 text-sm text-slate-500"
                   disabled />
        </div>

        <div>
            <label asp-for="Input.PhoneNumber" class="mb-2 block text-sm font-medium text-slate-700">
                Telefone
            </label>
            <input asp-for="Input.PhoneNumber"
                   class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200" />
            <span asp-validation-for="Input.PhoneNumber" class="mt-1 block text-sm text-red-600"></span>
        </div>

        <button id="update-profile-button"
                type="submit"
                class="inline-flex items-center justify-center rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-blue-700">
            Salvar alterações
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}