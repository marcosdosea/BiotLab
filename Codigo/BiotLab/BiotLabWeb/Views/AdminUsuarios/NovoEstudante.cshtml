@model BiotLabWeb.Models.AdminUsuarios.CriarUsuarioConviteViewModel

@{
    ViewData["Title"] = "Novo Estudante";
}

<div class="mb-8 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div class="flex items-start gap-4">
        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-blue-600 text-white shadow-lg shadow-blue-600/20">
            <i data-lucide="user-plus" class="h-7 w-7"></i>
        </div>
        <div>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">BiotLab</p>
            <h1 class="mt-1 text-3xl font-extrabold tracking-tight text-slate-950">Convidar estudante/pesquisador</h1>
            <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Envie um convite para que um novo estudante confirme a conta, defina a senha e complete o cadastro de pesquisador.</p>
        </div>
    </div>
    
</div>

<div class="max-w-2xl rounded-3xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 p-6">
        <h2 class="text-lg font-bold text-slate-950">Dados do convite</h2>
        <p class="mt-1 text-sm text-slate-500">O convidado receberá um link para ativar a conta e preencher os dados de pesquisador.</p>
    </div>
    <form asp-action="NovoEstudante" method="post" class="space-y-5 p-6">
        <div asp-validation-summary="ModelOnly" class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-bold text-red-700"></div>

        <div>
            <label asp-for="NomeCompleto" class="mb-2 block text-sm font-bold text-slate-700"></label>
            <input asp-for="NomeCompleto" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100" placeholder="Nome completo" />
            <span asp-validation-for="NomeCompleto" class="mt-1 block text-xs font-semibold text-red-600"></span>
        </div>

        <div>
            <label asp-for="Email" class="mb-2 block text-sm font-bold text-slate-700"></label>
            <input asp-for="Email" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100" placeholder="email@instituicao.br" />
            <span asp-validation-for="Email" class="mt-1 block text-xs font-semibold text-red-600"></span>
        </div>

        <div class="flex flex-col-reverse gap-3 border-t border-slate-200 pt-6 sm:flex-row sm:justify-end">
            <a asp-action="Index" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white px-5 py-3 text-sm font-bold text-slate-700 transition hover:bg-slate-50">
                <i data-lucide="arrow-left" class="h-4 w-4"></i> Voltar
            </a>
            <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-2xl bg-blue-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-blue-600/20 transition hover:bg-blue-700">
                <i data-lucide="send" class="h-4 w-4"></i> Enviar convite
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
